<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <com.davemorrissey.labs.subscaleview.SubsamplingScaleImageView
        android:id="@+id/image_ssi"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <com.github.chrisbanes.photoview.PhotoView
        android:id="@+id/photoView"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />


    <com.qwlyz.androidstudy.widget.WXVoiceButton
        android:id="@+id/btn_wx_voice"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="215dp" />


    <com.qwlyz.androidstudy.widget.AudioWaveView2
        android:background="@color/red"
        android:id="@+id/btn_wx_voice2"
        android:layout_width="300dp"
        android:layout_height="100dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="415dp" />


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="text" />

        <Button
            android:id="@+id/upload"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="upload" />

        <LinearLayout
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.qwlyz.androidstudy.DeleteView
                android:layout_width="50dp"
                android:layout_height="33dp"
                android:layout_margin="10dp" />

            <TextView
                android:id="@+id/text_send"
                android:layout_width="50dp"
                android:layout_height="35dp"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="10dp"
                android:background="@drawable/shape_send_bg"
                android:paddingHorizontal="10dp"
                android:paddingVertical="8dp"
                android:text="Send"
                android:textColor="@color/white"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/text_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/red"
            android:textSize="16sp" />
    </LinearLayout>

</FrameLayout>